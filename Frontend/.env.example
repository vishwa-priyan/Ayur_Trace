# ==========================================
# AyurTrace Frontend Environment Configuration
# ==========================================

# (Optional) Backend API Base URL
# 
# 1. Reverse Proxy / Nginx / Same-Origin Deployment:
#    Leave this EMPTY or comment it out. Frontend will make relative calls (/api/...) 
#    which resolve to the same server domain.
#
# 2. Separate Backend Domain (e.g. Render, Railway, AWS EC2):
#    Set to the full backend URL without trailing slash:
#    VITE_API_BASE_URL=https://api.yourdomain.com
#    OR
#    VITE_API_BASE_URL=http://YOUR_SERVER_IP:5000
#
VITE_API_BASE_URL=
