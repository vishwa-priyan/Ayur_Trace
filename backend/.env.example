# ==========================================
# AyurTrace Backend Environment Configuration
# ==========================================

# Server Port and Host
PORT=5000
HOST=0.0.0.0

# PostgreSQL Database Connection URL
# Example: postgres://username:password@localhost:5432/ayur_trace
DATABASE_URL=postgres://postgres:password@localhost:5432/ayur_trace

# Secret key used for signing JWT authentication tokens
JWT_SECRET=your_super_secret_jwt_key_here

# (Optional) Allowed CORS Origins
# Default is '*' (allow all). For strict production environments, specify origins separated by comma:
# CORS_ORIGIN=https://ayurtrace.yourdomain.com,http://localhost:8080
# CORS_ORIGIN=*

# (Optional) Serve frontend static files from backend
# Set to 'true' to have Express serve frontend/dist directly on the backend PORT:
# SERVE_FRONTEND=false
